{
  "name": "ms-3",
  "version": "1.0.0",
  "description": "Microservices and Distributed Tracing demo with express, Zipkin, and PostgreSQL",
  "main": "startAll",
  "scripts": {
    "analysis": "run-s populateZ analyzeT results",
    "startAll": "npm-run-all --parallel frontend filters services updaters",
    "testUpdateService": "npm-run-all --parallel frontend filters updaters getPatientByName",
    "testAdder": "npm-run-all --parallel frontend filters addPatient",
    "testGetters": "npm-run-all --parallel frontend getPatientByName getPatientBySSN filters",
    "waaaa": "npm-run-all --parallel frontend nameFilter",
    "frontend": "node -r ./service/instrumentation.js service/frontend.js",
    "filters": "npm-run-all --parallel diagFilter nameFilter pnumFilter sexFilter ssnFilter stCodFilter",
    "services": "npm-run-all --parallel addPatient delPatientBySSN delPatientByName getPatientByName getPatientBySSN",
    "updaters": "npm-run-all --parallel updPNum updDiag updStCod updSex",
    "patientName": "node service/micros/exists/patientName.js",
    "patientSSN": "node service/micros/exists/patientSSN.js",
    "diagFilter": "node service/micros/filters/diagFilter.js",
    "nameFilter": "node service/micros/filters/nameFilter.js",
    "pnumFilter": "node service/micros/filters/pnumFilter.js",
    "sexFilter": "node service/micros/filters/sexFilter.js",
    "ssnFilter": "node service/micros/filters/ssnFilter.js",
    "stCodFilter": "node service/micros/filters/stCodFilter.js",
    "addPatient": "node service/micros/services/addPatient.js",
    "getPatientByName": "node service/micros/services/getPatientByName.js",
    "getPatientBySSN": "node service/micros/services/getPatientBySSN.js",
    "delPatientByName": "node service/micros/services/delPatientByName.js",
    "delPatientBySSN": "node service/micros/services/delPatientBySSN.js",
    "updPNum": "node service/micros/services/updaters/updPNum.js",
    "updDiag": "node service/micros/services/updaters/updDiag.js",
    "updSex": "node service/micros/services/updaters/updSex.js",
    "updStCod": "node service/micros/services/updaters/updStCod.js",
    "populateZ" : "node populateWithZipkin.js",
    "analyzeT" : "node analyzeTraces.js",
    "results" : "node getResults.js"
  },
  "author": "DO-III",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.4.1",
    "@opentelemetry/auto-instrumentations-node": "^0.36.6",
    "@opentelemetry/core": "^1.12.0",
    "@opentelemetry/exporter-zipkin": "^1.12.0",
    "@opentelemetry/instrumentation": "^0.38.0",
    "@opentelemetry/instrumentation-express": "^0.32.1",
    "@opentelemetry/instrumentation-http": "^0.38.0",
    "@opentelemetry/resources": "^1.12.0",
    "@opentelemetry/sdk-metrics": "^1.12.0",
    "@opentelemetry/sdk-node": "^0.38.0",
    "@opentelemetry/sdk-trace-base": "^1.12.0",
    "@opentelemetry/sdk-trace-node": "^1.12.0",
    "@opentelemetry/semantic-conventions": "^1.12.0",
    "@prisma/client": "^5.6.0",
    "concurrently": "^8.2.1",
    "config": "^3.3.9",
    "express": "^4.18.2",
    "node-fetch": "^2.6.1",
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^5.6.0"
  }
}
